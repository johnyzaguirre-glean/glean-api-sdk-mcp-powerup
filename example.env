# Copy to .env and edit these placeholders. Do not source this file in a shell.
# Scripts read it as data. Values are not interpolated or executed.
GLEAN_BASE_URL=https://YOUR-INSTANCE-be.glean.com
# The helper creates this owner-only file. The .secrets directory is gitignored.
GLEAN_TOKEN_FILE=.secrets/glean-token
# Outer single quotes preserve the double quotes for an exact phrase search.
GLEAN_QUERY='"YOUR KNOWN DOCUMENT TITLE"'
# Optional: match one returned row against the document you opened in Glean.
GLEAN_EXPECTED_TITLE=YOUR KNOWN DOCUMENT TITLE
GLEAN_EXPECTED_URL=https://YOUR-DOCUMENT-HOST/PATH
# Optional, needed only for the MCP test. Leave blank until then.
# Copy the exact server URL from Glean, such as:
# https://YOUR-INSTANCE-be.glean.com/mcp/YOUR-SERVER-PATH
GLEAN_MCP_URL=
# Optional Chat question, independent of the Search phrase above.
# The Chat examples require a user Client API token with CHAT scope.
# Adapt this question to content available in your own tenant.
GLEAN_CHAT_QUERY='How do I call the Glean Search API?'
