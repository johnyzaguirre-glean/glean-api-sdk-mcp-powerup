# Copy to indexing/.env. Read as data; never source this file in a shell.
GLEAN_INDEXING_BASE_URL=https://YOUR-SANDBOX-be.glean.com
GLEAN_INDEXING_TOKEN_FILE=.secrets/glean-indexing-token
# Ask an administrator to create this dedicated test datasource first.
# The API name must start with powerupdemo and contain only letters/digits.
GLEAN_INDEXING_DATASOURCE=powerupdemoYOURSUFFIX
# One existing sandbox user's email. This is the only document ACL recipient.
GLEAN_INDEXING_TEST_EMAIL=YOUR-TEST-USER@example.com
# Optional for check_permissions.py: a second approved real sandbox user.
# Must not be the allowed reader or an alias of that same person.
# Leave blank to report the expected-denied check as NOT_RUN.
GLEAN_INDEXING_DENIED_TEST_EMAIL=
# Use this phrase in the Glean app after the document is indexed.
GLEAN_INDEXING_QUERY='"PowerUp Demo: Orion Service Recovery"'
